# ============================================
#  Backend Environment Configuration (Example)
#  Copy this file to .env and fill in real values
#  NEVER commit your real .env file!
# ============================================

# CORS: Comma-separated list of allowed frontend origins
# Example: FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend URL used in email templates
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String
MONGO_URL=mongodb://localhost:27017/PlayzoneDB

# JWT Secret (change to a strong random value in production!)
JWT_SECRET=your-jwt-secret-key-here

# Email Configuration (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Tournament Support <your-email@gmail.com>"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=500
